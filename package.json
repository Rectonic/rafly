{
  "name": "lastbite-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:sim": "LASTBITE_DISABLE_IOS_MLKIT=1 expo run:ios",
    "pods:ios:device": "cd ios && pod install",
    "pods:ios:sim": "cd ios && LASTBITE_DISABLE_IOS_MLKIT=1 pod install",
    "web": "expo start --web",
    "postinstall": "node scripts/fix-expo-constants-podspec.mjs",
    "backend:auth-smoke": "node scripts/supabase-auth-smoke.cjs",
    "backend:e2e": "node scripts/supabase-reservation-lifecycle-e2e.cjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib data i18n types __tests__"
  },
  "dependencies": {
    "@expo/log-box": "55.0.12",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "expo": "~55.0.26",
    "expo-build-properties": "~55.0.14",
    "expo-camera": "~55.0.19",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "~55.0.22",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "jest-expo": "~55.0.18",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
