EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Simulator and e2e escape hatch. Allows the unencrypted AsyncStorage fallback when SecureStore is unavailable, covering v1 and v2 pickup codes plus the buyer installation id. Without it those writes fail closed and stay in memory for the session. Never enable in production builds.
EXPO_PUBLIC_LASTBITE_ALLOW_INSECURE_CODE_STORE=
