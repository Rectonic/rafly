{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "types": ["jest", "react-native"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app",
    "components",
    "lib",
    "types",
    "data",
    "i18n",
    "constants",
    "__tests__",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    "dist",
    ".next",
    ".worktrees",
    "ios",
    "public",
    "supabase"
  ]
}
